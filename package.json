{
  "name": "corebox-rs",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "server": "node local-db-server.js",
    "start:local": "node local-db-server.js",
    "check:js": "node scripts/check-js.mjs",
    "check:config": "node -e \"JSON.parse(require('fs').readFileSync('config.json', 'utf8')); console.log('config.json: OK')\"",
    "test:local-db": "node scripts/test-local-db.mjs",
    "seed:pvp": "node scripts/seed-pvp-test-accounts.mjs",
    "test:local-pvp": "npm run seed:pvp && node scripts/test-local-pvp.mjs",
    "test:headless": "node scripts/test-long-headless.mjs",
    "test:retention-1000h": "node scripts/test-retention-1000h.mjs",
    "audit:static": "node scripts/corebox-static-audit.mjs",
    "seed:map-load": "node scripts/seed-map-load.mjs",
    "clean:map-load": "node scripts/clean-map-load.mjs",
    "audit:balance": "node scripts/balance-audit.mjs",
    "test:quest-contract": "node scripts/test-quest-contract.mjs",
    "test:save-integrity": "node scripts/test-save-integrity.mjs",
    "check:rust": "cargo check",
    "build:wasm": "wasm-pack build --target web --release --out-dir pkg",
    "check:wasm": "npm run build:wasm",
    "fmt:check": "cargo fmt -- --check",
    "test": "cargo test",
    "check": "npm run check:js && npm run check:config && npm run fmt:check && npm run check:rust && npm run check:wasm && npm test"
  },
  "dependencies": {
    "pixi.js": "^8.19.0"
  }
}
